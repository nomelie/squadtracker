rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only emails listed in the "allowed" collection can use the app.
    function isFriend() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowed/$(request.auth.token.email));
    }

    // Public stars: every friend can read, each person edits only their own.
    match /logs/{uid} {
      allow read: if isFriend();
      allow write: if isFriend() && request.auth.uid == uid;
    }

    // Private workout details: only the owner can read or write.
    match /users/{uid}/{document=**} {
      allow read, write: if isFriend() && request.auth.uid == uid;
    }
  }
}